# Copy this file to .env for local development.
# Never commit real credentials.

# Required in production. Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-value

# True for local development. Must be False on Render.
DEBUG=True

# Comma-separated hostnames. Include the Render subdomain and any custom domain.
# Example: aureta-digital.onrender.com,www.example.com,example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated HTTPS origins for CSRF. Required when DEBUG=False.
# Example: https://aureta-digital.onrender.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Leave empty locally to use SQLite. On Render, set the Neon connection string.
# Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional email (console backend is used when DEBUG=True).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Prestige Wealth Bank <noreply@localhost>
